# =============================================================================
# AI Quant Trading Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values as needed.
# The platform runs without any API keys in development mode.
# Never commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development
# Options: development, testing, production
APP_DEBUG=true
APP_LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# --- Database ---
# SQLite (default for development — no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./platform.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aiquant

# --- API Server ---
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000"]

# --- Security ---
# SECRET_KEY=  # Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Used for future JWT auth. Not required in development mode.

# --- AI Model Providers & Auto-Selection ---
# Options: auto (dynamic fallback across all active keys), groq, gemini, mistral, nvidia, openrouter, mock
AI_PROVIDER=auto
AI_AUTO_FALLBACK=true
# Configured Provider Keys (Add in .env or GitHub Secrets):
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL_NAME=

# --- Market Data Providers (Phase 5) ---
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=

# --- Broker Integration (Phase 5) ---
BROKER_PROVIDER=paper
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_BASE_URL=

# --- Notifications & Telegram ---
# Options: mock, telegram
NOTIFICATION_PROVIDER=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_USERNAME=@tradingtipsworld

# --- Risk Engine ---
RISK_MAX_POSITION_SIZE_PCT=10.0
RISK_MAX_PORTFOLIO_EXPOSURE_PCT=80.0
RISK_MAX_DRAWDOWN_PCT=20.0
RISK_MAX_CONCENTRATION_PCT=25.0
RISK_PAPER_ONLY=true
# RISK_KILL_SWITCH=false

# --- Paper Trading ---
PAPER_INITIAL_CASH=1000000.0
# Starting cash in INR for paper trading

# --- Monitoring ---
# SENTRY_DSN=
# PROMETHEUS_ENABLED=false
